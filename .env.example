# Build-time settings. Set these in Amplify > Hosting > Environment variables (then redeploy).
# Nothing below is required to build; each feature switches on when its value is set.

# Quote form: the Lambda Function URL from infra/lambda/quote-form (form shows "please call" until set)
NEXT_PUBLIC_QUOTE_ENDPOINT=

# Google tag. AW-761452231 is the tag Site Kit loads on the WordPress site today.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Only if GA4 is NOT already a destination of the AW tag (Google tag settings > Destinations).
NEXT_PUBLIC_GA_ID=
# Optional direct Ads conversions (Ads > Goals > Conversions > the action > Tag setup > "send_to" label).
# Leave empty if your conversion action already counts the "contact" event, or you'll double count.
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=

# Search engine verification meta tags (content value only, not the whole tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
