{
  "name": "a2zautodismantlers",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild.mjs",
    "serve": "node scripts/serve-out.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:content",
    "test:unit": "vitest run",
    "test:content": "node scripts/check-content.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:seo": "node scripts/check-seo.mjs",
    "test:perf": "node scripts/check-perf.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:links && npm run test:seo && npm run test:perf && npm run test:e2e",
    "brand": "node scripts/brand/build-og.mjs",
    "icons": "node scripts/build-icons.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "test:lambda": "python3 -m pytest -q infra/lambda"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
